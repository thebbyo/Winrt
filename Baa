        public void GeneratePanierByStatusGroup(List<KeyboardShortcut> shortcuts, ShortcutListType type)
        {
            var query = from item in shortcuts
                        group item by item.helperCategory into g
                        orderby g.Key
                        select new { GroupName = g.Key, Items = g };

            foreach (var g in query)
            {
                GroupInfosList info = new GroupInfosList();
                info.Key = KeyboardShortcutHelperCategoryText[g.GroupName];

                foreach (var item in g.Items)
                {
                    info.Add(item);
                }

                if (type == ShortcutListType.NoteTextEditKeyboardShortcuts)
                {
                    NoteTextEditShortcuts.Add(info);
                }
                else if (type == ShortcutListType.NoteViewPanelControlKeyboardShortcuts)
                {
                    NoteViewPanelControlShortcuts.Add(info);
                }
            }
        }
