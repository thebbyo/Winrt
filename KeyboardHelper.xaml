<UserControl
    x:Class="SamsungNotes.UI.Controls.KeyboardHelper"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamsungNotes.UI.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="KeyboardTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#010102"/>
        </Style>

        <DataTemplate x:Key="KeyboardHelperTemplate"
                      x:DataType="local:KeyboardShortcut">

            <Grid MinHeight="43" Margin="0,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Bind FuncName}"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">

                    <TextBlock Text="{x:Bind ShortcutKey1}"
                               Style="{StaticResource KeyboardTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ShortcutKey2}"
                               Style="{StaticResource KeyboardTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ShortcutKey3}"
                               Style="{StaticResource KeyboardTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ShortcutKey4}"
                               Style="{StaticResource KeyboardTextBlockStyle}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="KeyboardHelperGroupHeaderTemplate"
                      x:DataType="local:GroupInfosList">

            <TextBlock Text="{x:Bind Key}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#333"
                       Margin="0,12,0,5"/>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Keyboard Shortcuts"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="20"/>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              Margin="20">

            <!-- LEFT -->
            <ListView ItemsSource="{x:Bind ViewModel.NoteTextEditShortcuts}"
                      ItemTemplate="{StaticResource KeyboardHelperTemplate}"
                      Grid.Column="0">

                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <StaticResource ResourceKey="KeyboardHelperGroupHeaderTemplate"/>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>

            </ListView>

            <!-- RIGHT -->
            <ListView ItemsSource="{x:Bind ViewModel.NoteViewPanelControlShortcuts}"
                      ItemTemplate="{StaticResource KeyboardHelperTemplate}"
                      Grid.Column="1">

                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <StaticResource ResourceKey="KeyboardHelperGroupHeaderTemplate"/>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>

            </ListView>

        </Grid>
    </Grid>
</UserControl>
