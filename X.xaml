winrt::Windows::Foundation::IAsyncAction OtherPage::downloadPdfButton_Click(
    winrt::Windows::Foundation::IInspectable const&,
    winrt::Microsoft::UI::Xaml::RoutedEventArgs const&)
{
    auto sourcePath = Episode4::PdfState::SelectedPdfPath();

    if (sourcePath.empty())
    {
        pdfStatusText().Text(L"Please select a PDF first.");
        co_return;
    }

    FileSavePicker savePicker(this->XamlRoot().ContentIsland().Environment().AppWindowId());
    savePicker.SuggestedStartLocation(PickerLocationId::DocumentsLibrary);
    savePicker.SuggestedFileName(Episode4::PdfState::SelectedPdfName());
    savePicker.CommitButtonText(L"Download PDF");
    savePicker.DefaultFileExtension(L".pdf");
    savePicker.FileTypeChoices().Insert(
        L"PDF Document",
        winrt::single_threaded_vector<winrt::hstring>({ L".pdf" })
    );

    auto saveResult = co_await savePicker.PickSaveFileAsync();

    if (!saveResult)
    {
        pdfStatusText().Text(L"Download cancelled.");
        co_return;
    }

    try
    {
        std::filesystem::copy_file(
            std::filesystem::path(winrt::to_string(sourcePath)),
            std::filesystem::path(winrt::to_string(saveResult.Path())),
            std::filesystem::copy_options::overwrite_existing
        );

        pdfStatusText().Text(L"PDF downloaded successfully.");
    }
    catch (...)
    {
        pdfStatusText().Text(L"Failed to download PDF.");
    }
}
