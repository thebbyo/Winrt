KeyboardHelper.xaml

<UserControl
    x:Class="SamsungNotes.UI.Controls.KeyboardHelper"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamsungNotes.UI.Controls"
    mc:Ignorable="d">
    <UserControl.Resources>
        <CollectionViewSource
            x:Key="NoteTextEditKeyboardHelperSource"
            Source="{Binding NoteTextEditShortcuts}"
            IsSourceGrouped="False"/>
        <CollectionViewSource
            x:Key="ViewPanelControlKeyboardHelperSource"
            Source="{Binding NoteViewPanelControlShortcuts}"
            IsSourceGrouped="False"/>
        <DataTemplate
            x:Key="KeyboardHelperTemplate"
            x:DataType="local:KeyboardShortcut">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="{x:Bind FuncName}"
                    FontSize="14"
                    VerticalAlignment="Center"/>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Border
                        Background="#EEEEF0"
                        CornerRadius="8"
                        Padding="10,5">
                        <TextBlock
                            Text="{x:Bind ShortcutKey1}"/>
                    </Border>
                    <Border
                        Background="#EEEEF0"
                        CornerRadius="8"
                        Padding="10,5">
                        <TextBlock
                            Text="{x:Bind ShortcutKey2}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
            Text="{Binding KeyboardHelperHeader}"
            FontSize="20"
            FontWeight="SemiBold"
            Margin="0,0,0,20"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListView
                Grid.Column="0"
                ItemsSource="{Binding Source={StaticResource NoteTextEditKeyboardHelperSource}}"
                ItemTemplate="{StaticResource KeyboardHelperTemplate}"/>
            <ListView
                Grid.Column="1"
                Margin="20,0,0,0"
                ItemsSource="{Binding Source={StaticResource ViewPanelControlKeyboardHelperSource}}"
                ItemTemplate="{StaticResource KeyboardHelperTemplate}"/>
        </Grid>
    </Grid>
</UserControl>

