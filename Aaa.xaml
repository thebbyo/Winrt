    int32_t FloatingToolbarBase::MyProperty()
    {
        return 0;
    }

    void FloatingToolbarBase::MyProperty(int32_t value)
    {

    }
    FloatingToolbarBase::FloatingToolbarBase() {
        InitializeComponent();
        Canvas::SetLeft(FloatingController(), floatingToolbarVM.left);
        Canvas::SetTop(FloatingController(), floatingToolbarVM.top);
    }

    void FloatingToolbarBase::DragHandle_PointerPressed(
        winrt::Windows::Foundation::IInspectable const& sender,
        PointerRoutedEventArgs const& e)
    {
        auto point = e.GetCurrentPoint(RootCanvas());

        floatingToolbarVM.onPointerPressed(
            point.Position(),
            point.Properties().IsRightButtonPressed(),
            point.Properties().IsMiddleButtonPressed());

        auto handle = sender.as<UIElement>();
        handle.CapturePointer(e.Pointer());
    }

    void FloatingToolbarBase::DragHandle_PointerMoved(
        winrt::Windows::Foundation::IInspectable const&,
        PointerRoutedEventArgs const& e)
    {
        if (!floatingToolbarVM.mTouchDown)
            return;

        auto point = e.GetCurrentPoint(RootCanvas());

        floatingToolbarVM.onPointerMoved(
            point.Position(),
            RootCanvas().ActualWidth(),
            RootCanvas().ActualHeight());

        Canvas::SetLeft(FloatingController(), floatingToolbarVM.left);
        Canvas::SetTop(FloatingController(), floatingToolbarVM.top);
    }

    void FloatingToolbarBase::DragHandle_PointerReleased(
        winrt::Windows::Foundation::IInspectable const& sender,
        PointerRoutedEventArgs const& e)
    {
        floatingToolbarVM.onPointerReleased();

        auto handle = sender.as<UIElement>();
        handle.ReleasePointerCapture(e.Pointer());
    }
    
}
