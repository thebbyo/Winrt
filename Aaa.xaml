<UserControl
    x:Class="SamsungNotes.UI.Controls.KeyboardHelper"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamsungNotes.UI.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!-- ========================= -->
        <!-- Text Style -->
        <!-- ========================= -->

        <Style x:Key="KeyboardTextBlockStyle"
               TargetType="TextBlock">

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#010102"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="TextWrapping"
                    Value="WrapWholeWords"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>

        <!-- ========================= -->
        <!-- Collection Sources -->
        <!-- ========================= -->

        <CollectionViewSource
            x:Key="NoteTextEditKeyboardHelperSource"
            Source="{Binding NoteTextEditShortcuts}"
            IsSourceGrouped="False"/>

        <CollectionViewSource
            x:Key="ViewPanelControlKeyboardHelperSource"
            Source="{Binding NoteViewPanelControlShortcuts}"
            IsSourceGrouped="False"/>

        <!-- ========================= -->
        <!-- Item Template -->
        <!-- ========================= -->

        <DataTemplate
            x:Key="KeyboardHelperTemplate"
            x:DataType="local:KeyboardShortcut">

            <Grid Margin="0,0,10,0"
                  MinHeight="43">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Function Name -->

                <TextBlock
                    Text="{x:Bind FuncName}"
                    FontSize="14"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    HorizontalTextAlignment="Left"
                    TextTrimming="CharacterEllipsis"/>

                <!-- Shortcut Keys -->

                <Grid Grid.Column="1"
                      HorizontalAlignment="Right">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Key 1 -->

                    <Border Grid.Column="0"
                            MinWidth="32"
                            Height="32"
                            CornerRadius="8"
                            Background="#EEEEF0"
                            Padding="5,0,5,0">

                        <TextBlock
                            Text="{x:Bind ShortcutKey1}"
                            Style="{StaticResource KeyboardTextBlockStyle}"/>

                    </Border>

                    <!-- Key 2 -->

                    <Border Grid.Column="1"
                            MinWidth="32"
                            Height="32"
                            Margin="10,0,0,0"
                            CornerRadius="8"
                            Background="#EEEEF0"
                            Padding="5,0,5,0">

                        <TextBlock
                            Text="{x:Bind ShortcutKey2}"
                            Style="{StaticResource KeyboardTextBlockStyle}"/>

                    </Border>

                    <!-- Key 3 -->

                    <Border Grid.Column="2"
                            MinWidth="32"
                            Height="32"
                            Margin="10,0,0,0"
                            CornerRadius="8"
                            Background="#EEEEF0"
                            Padding="5,0,5,0">

                        <TextBlock
                            Text="{x:Bind ShortcutKey3}"
                            Style="{StaticResource KeyboardTextBlockStyle}"/>

                    </Border>

                    <!-- Key 4 -->

                    <Border Grid.Column="3"
                            MinWidth="32"
                            Height="32"
                            Margin="10,0,0,0"
                            CornerRadius="8"
                            Background="#EEEEF0"
                            Padding="5,0,5,0">

                        <TextBlock
                            Text="{x:Bind ShortcutKey4}"
                            Style="{StaticResource KeyboardTextBlockStyle}"/>

                    </Border>

                </Grid>

            </Grid>

        </DataTemplate>

        <!-- ========================= -->
        <!-- ListView Item Style -->
        <!-- ========================= -->

        <Style x:Key="KeyboardHelperListViewItemStyle"
               TargetType="ListViewItem">

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="UseSystemFocusVisuals"
                    Value="False"/>

            <Setter Property="Margin"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0,0,10,0"/>

        </Style>

    </UserControl.Resources>

    <!-- ===================================================== -->
    <!-- ROOT -->
    <!-- ===================================================== -->

    <Grid x:Name="KeyboardHelperGrid"
          Background="White"
          CornerRadius="16"
          MaxWidth="960"
          MaxHeight="604"
          Margin="32"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->

        <Grid MinHeight="50">

            <TextBlock
                Margin="22,24,24,14"
                FontSize="14"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Text="{Binding KeyboardHelperHeader}"/>

        </Grid>

        <!-- ========================= -->
        <!-- CONTENT -->
        <!-- ========================= -->

        <ScrollViewer Grid.Row="1"
                      Margin="22,0,22,12"
                      VerticalScrollBarVisibility="Auto">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===================================== -->
                <!-- LEFT LIST -->
                <!-- ===================================== -->

                <ListView
                    x:Name="NoteTextKeyboardHelperList"
                    Grid.Column="0"
                    SelectionMode="None"
                    IsTabStop="False"
                    ItemsSource="{Binding Source={StaticResource NoteTextEditKeyboardHelperSource}}"
                    ItemTemplate="{StaticResource KeyboardHelperTemplate}"
                    ItemContainerStyle="{StaticResource KeyboardHelperListViewItemStyle}"/>

                <!-- ===================================== -->
                <!-- RIGHT LIST -->
                <!-- ===================================== -->

                <ListView
                    x:Name="ViewPanelControlKeyboardHelperList"
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    SelectionMode="None"
                    IsTabStop="False"
                    ItemsSource="{Binding Source={StaticResource ViewPanelControlKeyboardHelperSource}}"
                    ItemTemplate="{StaticResource KeyboardHelperTemplate}"
                    ItemContainerStyle="{StaticResource KeyboardHelperListViewItemStyle}"/>

            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>