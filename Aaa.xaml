#include "pch.h"
#include "HomePage.xaml.h"

#if __has_include("HomePage.g.cpp")
#include "HomePage.g.cpp"
#endif

using namespace winrt;
using namespace Microsoft::UI::Xaml;
using namespace Microsoft::UI::Xaml::Controls;
using namespace Microsoft::UI::Xaml::Input;

namespace winrt::Episode4::implementation
{
    HomePage::HomePage()
    {
        InitializeComponent();

        Canvas::SetLeft(FloatingController(), toolbarVM.left);
        Canvas::SetTop(FloatingController(), toolbarVM.top);
    }

    void HomePage::DragHandle_PointerPressed(
        winrt::Windows::Foundation::IInspectable const& sender,
        PointerRoutedEventArgs const& e)
    {
        auto point = e.GetCurrentPoint(RootCanvas());

        toolbarVM.onPointerPressed(
            point.Position(),
            point.Properties().IsRightButtonPressed(),
            point.Properties().IsMiddleButtonPressed());

        auto handle = sender.as<UIElement>();
        handle.CapturePointer(e.Pointer());
    }

    void HomePage::DragHandle_PointerMoved(
        winrt::Windows::Foundation::IInspectable const&,
        PointerRoutedEventArgs const& e)
    {
        if (!toolbarVM.mTouchDown)
            return;

        auto point = e.GetCurrentPoint(RootCanvas());

        toolbarVM.onPointerMoved(
            point.Position(),
            RootCanvas().ActualWidth(),
            RootCanvas().ActualHeight());

        Canvas::SetLeft(FloatingController(), toolbarVM.left);
        Canvas::SetTop(FloatingController(), toolbarVM.top);
    }

    void HomePage::DragHandle_PointerReleased(
        winrt::Windows::Foundation::IInspectable const& sender,
        PointerRoutedEventArgs const& e)
    {
        toolbarVM.onPointerReleased();

        auto handle = sender.as<UIElement>();
        handle.ReleasePointerCapture(e.Pointer());
    }
}