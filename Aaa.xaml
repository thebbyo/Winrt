namespace winrt::Episode4::implementation
{
	HomePage::HomePage() {
		
		InitializeComponent();
	}

	void HomePage::DragHandle_PointerPressed(
		winrt::Windows::Foundation::IInspectable const&, winrt::Microsoft::UI::Xaml::Input::PointerRoutedEventArgs const& e
	) {
		isDragging = true;
		lastPoint = e.GetCurrentPoint(RootCanvas()).Position();
	}
	void HomePage::DragHandle_PointerMoved(
		winrt::Windows::Foundation::IInspectable const&, winrt::Microsoft::UI::Xaml::Input::PointerRoutedEventArgs const& e

	) {
		if (!isDragging) return;
		winrt::Windows::Foundation::Point current = e.GetCurrentPoint(RootCanvas()).Position();
		double dx = current.X - lastPoint.X;
		double dy = current.Y - lastPoint.Y;

		double left = Microsoft::UI::Xaml::Controls::Canvas::GetLeft(FloatingController());
		double top = Microsoft::UI::Xaml::Controls::Canvas::GetTop(FloatingController());
		Microsoft::UI::Xaml::Controls::Canvas::SetLeft(FloatingController(), left + dx);
		Microsoft::UI::Xaml::Controls::Canvas::SetTop(FloatingController(), top + dy);
		lastPoint = current;
	}

	void HomePage::DragHandle_PointerReleased(winrt::Windows::Foundation::IInspectable const&, winrt::Microsoft::UI::Xaml::Input::PointerRoutedEventArgs const& e

	) {
		isDragging = false;
	}






	
	
	

}
